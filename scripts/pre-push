#!/bin/sh
# Blocks a push unless the safety bar passes: the answer-file setting is present (else RUN-TRACES-NOT-RUN, exit 1),
# no answer file is tracked, the refusal lines are signed in both files, the full suite passes with no skips, and
# the derived traces run (room rulings, 15 Oct 2026). Install: ln -s ../../scripts/pre-push .git/hooks/pre-push
cd "$(git rev-parse --show-toplevel)" || exit 1
exec python3 scripts/prepush.py
